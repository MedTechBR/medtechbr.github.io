    {
      "id": "amb",
      "titulo": "Ambulatorial",
      "sub": "Abstinência leve e sem risco de complicação",
      "blocos": [
        {
          "tipo": "orientacao",
          "titulo": "Orientações ao prescritor",
          "itens": [
            "Só trate em casa com CIWA-Ar <10, sem convulsão ou delirium prévios, sem doença clínica descompensada, com acompanhante e retorno em 24 a 48 h.",
            "Risco de abstinência complicada (PAWSS alto, história de convulsão ou delirium tremens): interne.",
            "Carbamazepina ou gabapentina servem ao paciente de baixo risco ou com contraindicação a benzodiazepínico.",
            "Ofereça tratamento do transtorno por uso de álcool já na primeira consulta e vincule ao CAPS-AD."
          ]
        },
        {
          "tipo": "esquema",
          "titulo": "Controle dos sintomas",
          "regra": "Escolha uma opção.",
          "partes": [
            {
              "rotulo": "",
              "opcoes": [
                {
                  "farmaco": "Carbamazepina",
                  "apresentacao": "comprimido 200 mg",
                  "posologia": "200 mg VO de 8/8 h (600 mg/dia); reduzir até 200 a 400 mg/dia",
                  "duracao": "4 a 9 dias",
                  "diluicao": "",
                  "dose_valor": 200,
                  "dose_unidade": "mg",
                  "via": "VO",
                  "intervalo_horas": 8,
                  "continuo": false,
                  "dose_unica": false,
                  "se_necessario": false,
                  "dose_por_kg": null,
                  "obs": "Evite em hepatopatia, plaquetopenia e com muitos fármacos (indutor enzimático)."
                },
                {
                  "farmaco": "Gabapentina",
                  "apresentacao": "cápsula 300 mg ou 400 mg",
                  "posologia": "400 mg VO de 8/8 h (1.200 mg/dia) por 1 a 3 dias; reduzir para 300 a 600 mg/dia até o 4º a 7º dia",
                  "duracao": "4 a 7 dias",
                  "diluicao": "",
                  "dose_valor": 400,
                  "dose_unidade": "mg",
                  "via": "VO",
                  "intervalo_horas": 8,
                  "continuo": false,
                  "dose_unica": false,
                  "se_necessario": false,
                  "dose_por_kg": null,
                  "obs": "Ajuste pela TFG (CKD-EPI 2021). Risco de uso indevido: entregue poucas doses por vez."
                },
                {
                  "farmaco": "Diazepam",
                  "apresentacao": "comprimido 10 mg",
                  "posologia": "10 mg VO de 6/6 h no 1º dia, 8/8 h no 2º, 12/12 h no 3º e à noite no 4º dia",
                  "duracao": "4 dias",
                  "diluicao": "",
                  "dose_valor": 10,
                  "dose_unidade": "mg",
                  "via": "VO",
                  "intervalo_horas": 6,
                  "continuo": false,
                  "dose_unica": false,
                  "se_necessario": false,
                  "dose_por_kg": null,
                  "obs": "Entregue só as doses até o próximo retorno. Não associe ao álcool."
                }
              ]
            }
          ]
        },
        {
          "tipo": "lista",
          "titulo": "Vitaminas",
          "partes": [
            {
              "rotulo": "",
              "opcoes": [
                {
                  "farmaco": "Tiamina",
                  "apresentacao": "comprimido 300 mg",
                  "posologia": "300 mg VO 1x/dia",
                  "duracao": "5 dias",
                  "diluicao": "",
                  "dose_valor": 300,
                  "dose_unidade": "mg",
                  "via": "VO",
                  "intervalo_horas": 24,
                  "continuo": false,
                  "dose_unica": false,
                  "se_necessario": false,
                  "dose_por_kg": null,
                  "obs": "A ASAM cita 100 mg/dia; 300 mg é a apresentação oral mais comum no Brasil. Absorção oral é baixa no etilista."
                }
              ]
            }
          ]
        }
      ]
