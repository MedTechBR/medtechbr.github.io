    {
      "id": "uti",
      "titulo": "UTI: grave ou delirium tremens",
      "sub": "CIWA-Ar ≥19, convulsão ou delirium",
      "blocos": [
        {
          "tipo": "orientacao",
          "titulo": "Orientações ao prescritor",
          "itens": [
            "Carregue cedo: diazepam EV em doses repetidas até o paciente ficar calmo e despertável (RASS 0 a -1). Depois, passe para o esquema oral guiado por sintomas.",
            "Delirium tremens que não cede costuma ser benzodiazepínico em dose baixa. Suba a dose antes de chamar de refratário.",
            "Sem controle após 40 a 50 mg de diazepam EV em 1 h, ou 150 a 200 mg em 3 a 4 h: associe fenobarbital.",
            "Dexmedetomidina e antipsicótico são adjuvantes. Propofol só no intubado.",
            "Doses altas de diazepam EV trazem propilenoglicol: vigie acidose metabólica e hiponatremia.",
            "Glicose e tiamina podem ser dadas em qualquer ordem (ASAM 2020); nunca atrase a glicose na hipoglicemia."
          ]
        },
        {
          "tipo": "esquema",
          "titulo": "Benzodiazepínico EV",
          "regra": "Doses repetidas até o alvo de sedação.",
          "partes": [
            {
              "rotulo": "",
              "opcoes": [
                {
                  "farmaco": "Diazepam",
                  "apresentacao": "ampola 10 mg/2 mL",
                  "posologia": "10 a 20 mg EV a cada 5 a 10 min até o paciente ficar calmo e despertável",
                  "duracao": "",
                  "diluicao": "Sem diluir, a até 5 mg/min, em veia calibrosa. Não misturar em soro.",
                  "dose_valor": 10,
                  "dose_unidade": "mg",
                  "via": "EV",
                  "intervalo_horas": null,
                  "continuo": false,
                  "dose_unica": false,
                  "se_necessario": true,
                  "dose_por_kg": null,
                  "obs": "Pode exigir doses muito altas. Acima de 40 a 50 mg EV em 1 h sem controle: associe fenobarbital."
                }
              ]
            }
          ]
        },
        {
          "tipo": "esquema",
          "titulo": "Adjuvantes na abstinência resistente",
          "regra": "Some ao benzodiazepínico, nunca em seu lugar. Fenobarbital primeiro.",
          "partes": [
            {
              "rotulo": "Primeiro",
              "opcoes": [
                {
                  "farmaco": "Fenobarbital",
