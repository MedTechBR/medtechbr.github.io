                  "diluicao": "Diluir em 100 mL de SF 0,9% e infundir em 30 min. Para 70 kg: 700 mg (7 mL).",
                  "dose_valor": 10,
                  "dose_unidade": "mg/kg",
                  "via": "EV",
                  "intervalo_horas": null,
                  "continuo": false,
                  "dose_unica": true,
                  "se_necessario": false,
                  "dose_por_kg": {
                    "valor": 10,
                    "unidade": "mg/kg"
                  },
                  "obs": "Adjuvante ao benzodiazepínico, com monitor e via aérea à mão. Soma depressão respiratória."
                }
              ]
            },
            {
              "rotulo": "Depois, conforme o caso",
              "opcoes": [
                {
                  "farmaco": "Dexmedetomidina",
                  "apresentacao": "ampola 100 mcg/mL (2 mL)",
                  "posologia": "0,2 a 0,7 mcg/kg/h EV em bomba de infusão, sem bolus",
                  "duracao": "",
                  "diluicao": "200 mcg (2 mL) + 48 mL de SF 0,9% = 4 mcg/mL. Para 70 kg: 0,2 mcg/kg/h = 3,5 mL/h.",
                  "dose_valor": 0.2,
                  "dose_unidade": "mcg/kg/h",
                  "via": "EV",
                  "intervalo_horas": null,
                  "continuo": true,
                  "dose_unica": false,
                  "se_necessario": false,
                  "dose_por_kg": {
                    "valor": 0.2,
                    "unidade": "mcg/kg/h"
                  },
                  "obs": "Controla o componente adrenérgico, mas não previne convulsão: nunca substitui o benzodiazepínico. Bradicardia e hipotensão."
                },
